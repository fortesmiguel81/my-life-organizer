DATABASE_URL=postgres://milo:milo@localhost:5432/milo

# Public base URL the browser/typed API client hits
NEXT_PUBLIC_API_URL=http://localhost:3000

# Shared household password gating the whole app before the profile picker.
# Required — without it every request is rejected. Pick something you'd be
# comfortable typing on a shared/kids' device, not your main password.
APP_PASSWORD=<CHOOSE_A_PASSWORD>

# 64-char hex key for AES-256-GCM field encryption
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=<64_HEX_CHARS>

# Google Calendar OAuth (https://console.cloud.google.com/) — optional
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback

# Local file storage for the documents module
UPLOADS_DIR=/data/uploads

# ntfy (self-hosted push notifications, see docker-compose.yml)
NTFY_URL=http://ntfy:80

# Secret used to authenticate cron calls to /api/notifications/process
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=<YOUR_CRON_SECRET>
